# Copy to .env.local (never commit .env.local). See docs/ARCHITECTURE.md section 6.
# All of these are read on the server only (Next.js route handlers), never sent to the browser.

# Local model service (api/ FastAPI: POST /predict, POST /restroom/compare, POST /restroom/match, GET /health)
MODEL_API_URL=http://localhost:8000

# Hosted model service (Hugging Face Space or Roboflow). Leave empty to disable the cloud provider.
CLOUD_MODEL_API_URL=

# Only if the Roboflow hosted model is the cloud provider. Sent as ?api_key=... from the server.
ROBOFLOW_API_KEY=

# Used by api/, not by the web app. Listed here so one file documents every variable.
# MODEL_WEIGHTS=weights/best.pt
